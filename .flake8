[flake8]

# E402 module level import not at top of file
# gi.require_version() is required before later imports

# E501 line too long (%d > 79 characters)
# files have embedded SVGs yet to be reformatted or moved to files

# W503 line break before binary operator
# is okay provided there is consistency

# Use extend-ignore, not ignore: plain `ignore` REPLACES flake8's built-in
# default ignore list, which silently re-enables cosmetic checks like E226
# (missing whitespace around arithmetic operator) that the defaults exclude.
extend-ignore = E402,E501,W503
